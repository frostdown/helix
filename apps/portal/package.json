{
  "name": "@azx-pbc/portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/free-port.mjs 3001 && tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc",
    "postinstall": "pnpm db:generate",
    "db:generate": "rm -rf src/db/generated && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:azure": "tsx scripts/migrate-deploy.ts",
    "db:reset": "prisma migrate reset --force",
    "seed:llm": "tsx scripts/seed-platform-secret.ts",
    "db:backfill-owners": "tsx scripts/backfill-app-owners.ts"
  },
  "dependencies": {
    "@azure/identity": "catalog:",
    "@azure/storage-blob": "catalog:",
    "@fastify/multipart": "catalog:",
    "@fastify/static": "catalog:",
    "@azx-pbc/secret-store": "workspace:*",
    "@azx-pbc/shared": "workspace:*",
    "@azx-pbc/telemetry": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "jose": "catalog:",
    "pg": "catalog:",
    "yauzl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@azx-pbc/dev-idp": "workspace:*",
    "@types/archiver": "catalog:",
    "@types/pg": "catalog:",
    "@types/yauzl": "catalog:",
    "archiver": "catalog:",
    "form-data": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
